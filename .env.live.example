# Copy to .env.live (never share or commit it). Used only by: npm run verify:live
# The frontend URL and publishable key are read from .env.local.

# Real Super Admin of company ALTON — used READ-ONLY (no records are created in ALTON).
LIVE_SUPERADMIN_EMAIL=
LIVE_SUPERADMIN_PASSWORD=

# Test accounts created for supabase/staging/seed_staging_test_data.sql:
#   <prefix>+stg-superadmin@<domain>, <prefix>+stg-admin@<domain>, ... (10 accounts, one shared TEST password)
STAGING_EMAIL_PREFIX=
STAGING_EMAIL_DOMAIN=
STAGING_TEST_PASSWORD=
