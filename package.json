    "test:db:product-import": "node tests/db/product-import-safety-check.mjs",
    "test:db:purchase-cost": "node tests/db/purchase-cost-check.mjs",
    "test:db:uom": "node tests/db/product-uom-check.mjs",
    "test:db:image-link": "node tests/db/product-image-link-check.mjs",
    "test:db:opening-stock": "node tests/db/opening-stock-check.mjs",
    "test:db:stock-value": "node tests/db/stock-valuation-check.mjs",
    "test:db:purchase-delete": "node tests/db/purchase-delete-check.mjs",
    "test:db:unified-cost": "node tests/db/unified-cost-check.mjs",
