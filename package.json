    "test:db:product-cost": "node tests/db/product-cost-intelligence-check.mjs",
    "test:db:gst-exclusive": "node tests/db/gst-exclusive-reporting-check.mjs",
    "test:db:rollback": "node tests/db/whole-piece-rollback-check.mjs && node tests/db/erp-reset-rollback-check.mjs && node tests/db/erp-force-reset-rollback-check.mjs && node tests/db/product-purchase-rollback-check.mjs && node tests/db/stock-reliability-rollback-check.mjs && node tests/db/invoice-dispatch-rollback-check.mjs && node tests/db/force-reset-direct-rollback-check.mjs && node tests/db/bom-planning-ean-rollback-check.mjs && node tests/db/partial-invoicing-rollback-check.mjs && node tests/db/user-invitations-rollback-check.mjs && node tests/db/form-drafts-rollback-check.mjs && node tests/db/master-versioning-rollback-check.mjs && node tests/db/department-data-rollback-check.mjs && node tests/db/sku-free-format-rollback-check.mjs && node tests/db/purchase-delete-rollback-check.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:db:readonly": "node tests/db/readonly-rpc-check.mjs",
    "test": "npm run test:unit && npm run test:db && npm run test:db:readonly",
    "build:smoke": "vite build --outDir dist-smoke --emptyOutDir --mode smoke",
    "test:ui": "node tests/ui-smoke/run.mjs",
    "verify:supabase": "node --env-file=.env.staging scripts/verify-supabase.mjs",
    "verify:live": "node scripts/verify-v2-live.mjs",
    "verify:concurrency": "node --env-file=.env.staging scripts/concurrency-check.mjs",
    "test:staging-local": "node tests/db/staging-seed-check.mjs && node tests/db/staging-scripts-dryrun.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
