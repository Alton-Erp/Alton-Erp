# Copy to .env.local (git-ignored) and fill in values from
# Supabase Dashboard > Project Settings > API (Data API / API Keys).
#
# Only PUBLIC values belong here. Everything prefixed VITE_ is bundled into the
# browser JavaScript. NEVER put the service-role key, a secret key (sb_secret_...),
# or the database password in any VITE_ variable or in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). If your project only has the legacy
# keys, use the "anon public" key here instead (or set VITE_SUPABASE_ANON_KEY).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

