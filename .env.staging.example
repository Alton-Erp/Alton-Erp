# Template for the STAGING verification scripts. Copy to .env.staging (git-ignored)
# and fill in. Never commit .env.staging. Never put a secret / service-role key here.
#
#   copy .env.staging.example .env.staging      (Windows)
#   cp .env.staging.example .env.staging        (macOS / Linux)

# Staging project: Dashboard > Project Settings > API. PUBLIC values only.
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Test accounts created for supabase/staging/seed_staging_test_data.sql:
#   <STAGING_EMAIL_PREFIX>+stg-<role>@<STAGING_EMAIL_DOMAIN>, all with the same TEST password.
STAGING_EMAIL_PREFIX=your.mailbox
STAGING_EMAIL_DOMAIN=yourcompany.example
# A long random TEST password used ONLY for the stg- accounts on staging.
STAGING_TEST_PASSWORD=

# Optional: send one password-reset email to the +stg-viewer account.
# STAGING_SEND_RESET_EMAIL=yes
# STAGING_APP_URL=https://your-staging-app.example

# Required by scripts/concurrency-check.mjs (it writes test records). Set it only
# in .env.staging, never in a production environment file.
# CONFIRM_STAGING=yes
